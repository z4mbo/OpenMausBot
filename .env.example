# Convex CLI fills these public deployment URLs during local setup.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Use your HTTPS origin in production, with no trailing slash.
ORIGIN_PUBLIC_URL=http://localhost:3000
ORIGIN_LOCAL_DATA_DIR=.origin-data

# Convex environment only (npx convex env set): ORIGIN_SIGNUP_MODE=invite
# limits new accounts to invitation links. Leave unset for open sign-up.

# Generate with `openssl rand -hex 32`; also set it in Convex.
ORIGIN_INTEGRATION_SECRET=

# Set to 1 only when a reverse proxy in front of the app overwrites X-Real-IP with the client address
# (see deploy/README.md). Rate limits then apply per client; otherwise per endpoint.
ORIGIN_TRUSTED_PROXY=

# Instance operators (comma-separated emails). Only they may register the instance-wide GitHub App from
# Settings > Integrations. When empty (and ORIGIN_LEGACY_OWNER_EMAIL is empty), only the owner of the first
# workspace created on this instance may. Sign up with these addresses before opening sign-up.
ORIGIN_ADMIN_EMAILS=

# Optional GitHub App. Leave empty to let the instance operator register one from
# Settings > Integrations (stored encrypted in ORIGIN_LOCAL_DATA_DIR). Set the client id, secret and
# webhook secret to use an existing App instead; the App id and private key (PEM, "\n" for newlines)
# enable issues as pull requests. Never expose them through NEXT_PUBLIC_*.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Migration of an older Origin installation only; leave empty for a new installation.
# ORIGIN_LEGACY_OWNER_EMAIL also counts as an instance operator; GITHUB_TOKEN is used for that owner's legacy projects.
ORIGIN_LEGACY_OWNER_EMAIL=
GITHUB_TOKEN=

# Optional SMTP. Link invitations work without email delivery.
ORIGIN_SMTP_HOST=
ORIGIN_SMTP_PORT=465
ORIGIN_SMTP_SECURE=true
ORIGIN_SMTP_USER=
ORIGIN_SMTP_PASSWORD=
ORIGIN_SMTP_FROM=

# Optional self-hosted coturn relay.
ORIGIN_TURN_HOST=
ORIGIN_TURN_SECRET=
ORIGIN_TURN_REALM=
ORIGIN_TURN_PUBLIC_IP=
