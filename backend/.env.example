# Written by `npx convex dev` for the deployment it runs against.
CONVEX_DEPLOYMENT=

# Convex environment only (npx convex env set), never in this file:
#   ORIGIN_INTEGRATION_SECRET  random 64-hex string; the Origin app server signs /integrations calls with it
#   ORIGIN_PUBLIC_URL          public origin of the Origin app server (invite links, integrations tick)
#   ORIGIN_SITE_URL            optional; invite links use it before ORIGIN_PUBLIC_URL
#   ORIGIN_SIGNUP_MODE         "invite" limits new accounts to invitation links
#   RESEND_API_KEY, INVITE_FROM_EMAIL  optional invite email delivery
#   GITHUB_TOKEN               optional token for the legacy owner's repositories
#   ORIGIN_LEGACY_OWNER_EMAIL, ORIGIN_LEGACY_WORKSPACE_SLUG  the legacy owner account and its workspace
