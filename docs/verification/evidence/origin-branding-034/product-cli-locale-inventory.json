{
  "changes": [
    {
      "locale": "en",
      "key": "onboarding.reel.terminal.body",
      "before": "From an Origin source checkout, run pnpm omb, pick a brain, and open the app in your browser. Pair a phone, or run it on a server.",
      "after": "From an Origin source checkout, run pnpm omb, pick a brain, and open the app in your browser. Pair a phone, or run it on a server."
    },
    {
      "locale": "en",
      "key": "remote.client.server.hint",
      "before": "From your Origin source checkout on the server, run this command to create a fresh, single-use pairing link. Paste the full link below, including its 12-character code.",
      "after": "From your Origin source checkout on the server, run this command to create a fresh, single-use pairing link. Paste the full link below, including its 12-character code."
    },
    {
      "locale": "ja",
      "key": "onboarding.reel.terminal.body",
      "before": "npx openmausbot と入力してモデルを選ぶと、同じアプリがブラウザーで開きます。スマートフォンをペアリングしたり、サーバーで動かしたりできます。",
      "after": "Origin のソースコードから pnpm omb を実行し、モデルを選んでブラウザーでアプリを開きます。スマートフォンをペアリングしたり、サーバーで動かしたりできます。"
    },
    {
      "locale": "ja",
      "key": "remote.client.server.hint",
      "before": "サーバーでこのコマンドを実行し、新しい一度限りのペアリングリンクを作成してください。12 文字のコードを含め、リンク全体を下に貼り付けてください。",
      "after": "サーバー上の Origin のソースコードからこのコマンドを実行して、新しい使い捨てペアリングリンクを作成します。12 文字のコードを含む完全なリンクを下に貼り付けてください。"
    },
    {
      "locale": "zh",
      "key": "onboarding.reel.terminal.body",
      "before": "输入 npx openmausbot，选一个大脑，同一个应用程序就会在你的浏览器中打开。也可以配对手机，或把它放到服务器上。",
      "after": "在 Origin 源代码目录中运行 pnpm omb，选择模型，然后在浏览器中打开应用。你也可以配对手机，或在服务器上运行它。"
    },
    {
      "locale": "zh",
      "key": "remote.client.server.hint",
      "before": "请在你的服务器上运行这个指令，以创建全新的一次性配对链接。将完整链接（包含其 12 个字符的配对码）贴在下方。",
      "after": "在服务器上的 Origin 源代码目录中运行此命令，创建一个新的一次性配对链接。在下方粘贴完整链接，包括其中的 12 位代码。"
    },
    {
      "locale": "zh-tw",
      "key": "onboarding.reel.terminal.body",
      "before": "輸入 npx openmausbot，選一個大腦，同一個應用程式就會在你的瀏覽器中開啟。也可以配對手機，或把它放到伺服器上。",
      "after": "在 Origin 原始碼目錄中執行 pnpm omb，選擇模型，再於瀏覽器開啟應用程式。你也可以配對手機，或在伺服器上執行。"
    },
    {
      "locale": "zh-tw",
      "key": "remote.client.server.hint",
      "before": "請在你的伺服器上執行這個指令，以建立全新的一次性配對連結。將完整連結（包含其 12 個字元的配對碼）貼在下方。",
      "after": "在伺服器上的 Origin 原始碼目錄中執行此指令，建立新的單次使用配對連結。請在下方貼上完整連結，包括其中的 12 字元驗證碼。"
    },
    {
      "locale": "uk",
      "key": "onboarding.reel.terminal.body",
      "before": "Введіть npx openmausbot, оберіть мозок — і той самий застосунок відкриється у вашому браузері. Прив'яжіть телефон або поставте на сервер.",
      "after": "У каталозі вихідного коду Origin запустіть pnpm omb, виберіть модель і відкрийте застосунок у браузері. Прив’яжіть телефон або запустіть його на сервері."
    },
    {
      "locale": "uk",
      "key": "remote.client.server.hint",
      "before": "На своєму сервері виконайте цю команду, щоб створити свіже одноразове посилання прив'язки. Вставте повне посилання нижче, разом із 12-символьним кодом.",
      "after": "У каталозі вихідного коду Origin на сервері виконайте цю команду, щоб створити нове одноразове посилання для прив’язки. Вставте нижче повне посилання разом із 12-символьним кодом."
    },
    {
      "locale": "vi",
      "key": "onboarding.reel.terminal.body",
      "before": "Nhập npx openmausbot, chọn một bộ não, và chính ứng dụng đó sẽ mở trong trình duyệt của bạn. Ghép nối điện thoại hoặc đưa ứng dụng lên máy chủ.",
      "after": "Từ mã nguồn Origin, chạy pnpm omb, chọn mô hình và mở ứng dụng trong trình duyệt. Ghép nối điện thoại hoặc chạy trên máy chủ."
    },
    {
      "locale": "vi",
      "key": "remote.client.server.hint",
      "before": "Trên máy chủ của bạn, hãy chạy lệnh này để tạo một liên kết ghép nối mới dùng một lần. Dán toàn bộ liên kết bên dưới, bao gồm cả mã 12 ký tự.",
      "after": "Từ mã nguồn Origin trên máy chủ, chạy lệnh này để tạo liên kết ghép nối mới chỉ dùng một lần. Dán liên kết đầy đủ bên dưới, bao gồm mã gồm 12 ký tự."
    },
    {
      "locale": "tr",
      "key": "onboarding.reel.terminal.body",
      "before": "npx openmausbot yazın, bir beyin seçin ve aynı uygulama tarayıcınızda açılsın. Bir telefon eşleştirin veya bir sunucuya kurun.",
      "after": "Origin kaynak kodu klasöründe pnpm omb çalıştırın, bir model seçin ve uygulamayı tarayıcınızda açın. Telefon eşleştirin veya sunucuda çalıştırın."
    },
    {
      "locale": "tr",
      "key": "remote.client.server.hint",
      "before": "Sunucunuzda yeni, tek kullanımlık bir eşleştirme bağlantısı oluşturmak için bu komutu çalıştırın. 12 karakterlik kodu da dahil olmak üzere tam bağlantıyı aşağıya yapıştırın.",
      "after": "Sunucunuzdaki Origin kaynak kodu klasöründe bu komutu çalıştırarak yeni, tek kullanımlık bir eşleştirme bağlantısı oluşturun. 12 karakterli kodu da içeren tam bağlantıyı aşağıya yapıştırın."
    }
  ],
