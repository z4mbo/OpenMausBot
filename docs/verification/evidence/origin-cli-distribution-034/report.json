  "findings": [
    {
      "severity": "P1",
      "file": "server/fleet.ts",
      "function": "upgradePlan",
      "scenario": "A fleet operator upgrades Origin. The production planner supplies npm install -g openmausbot@latest to the executor, followed by workspace restart and health steps; non-root and dry-run modes print that unsupported plan.",
      "proof": "The root-mode production executor was driven with recording dependencies, capturing the exact npm argv, restart and health call. No real package install or service operation occurred.",
      "fix": "Refuse at planning before executor mutation. The registry does not identify an Origin source checkout or revision, so automatic checkout replacement is unsupported."
    },
    {
      "severity": "P2",
      "files": [
        "server/cli-usage.ts",
        "server/cli.ts",
        "server/service-unit.ts"
      ],
      "scenario": "Origin help, non-interactive setup recovery and unstable npx-cache service guidance tell the user to fetch the upstream npm application.",
      "fix": "Use the actual Origin source checkout and pnpm scripts consistently in help, recovery instructions and source-hosting documentation. Preserve actual account/vendor identities and all wire/storage/service IDs."
    },
    {
      "severity": "P2",
      "file": "server/service-unit.ts",
      "function": "shippedSentinelCli",
      "scenario": "An optional Origin Sentinel service install discovers only the upstream desktop app and renders a schedule pointing to its executable and bundled CLI, replacing the invoking Origin checkout.",
      "proof": "The real service writer produced the upstream executable path in a disposable unit file on the baseline. Both-products and upstream-only cases are covered.",
      "fix": "Choose only Origin product directories and executable names. Linux retains the configured openmausbot executable and both platforms retain the bundled server/openmausbot.js filename. If no compatible Origin bundle is found, keep the invoking checkout script and Node."
    }
  ],
