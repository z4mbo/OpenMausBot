+function uniqueSlug(value: string, fallback: string, taken: Set<string>, max = 64): string {
+  const base = slug(value, max - 3) || fallback;
+  let candidate = base;
+  for (let n = 2; taken.has(candidate); n += 1) candidate = `${base}-${n}`;
+  taken.add(candidate);
+  return candidate;
